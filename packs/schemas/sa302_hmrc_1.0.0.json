      "type": "string",
      "description": "Tax year e.g. 2023-24.",
      "required": true,
      "aliases": [
        "Year"
      ]
    },
    {
      "key": "taxpayer_name",
      "type": "string",
      "description": "Taxpayer name.",
      "required": false,
      "aliases": [
        "Name"
      ]
    },
    {
      "key": "utr",
      "type": "string",
