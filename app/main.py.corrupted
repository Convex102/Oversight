@app.get("/billing/checkout")
def billing_checkout(plan: str, email: str, tenant_name: str):
    plan = (plan or "").lower().strip()
    price_id = None
    if plan in ("standard", "basic"):
        price_id = settings.STRIPE_PRICE_BASIC
    elif plan in ("pro",):
        price_id = settings.STRIPE_PRICE_PRO

    if not price_id:
        raise HTTPException(400, "Stripe price id not configured for plan")

    success = f"{settings.PUBLIC_BASE_URL}/console"
    cancel = f"{settings.PUBLIC_BASE_URL}/pricing"
    session = create_checkout_session(
        price_id=price_id,
        customer_email=email,
        success_url=success,
        cancel_url=cancel,
        metadata={"tenant_name": tenant_name, "plan": plan},
    )
    return RedirectResponse(url=session.url, status_code=303)

