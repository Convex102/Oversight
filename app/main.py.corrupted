@app.post("/v1/billing/portal")
def billing_portal(payload: dict, tenant=Depends(get_tenant), db: Session = Depends(get_db)):
    t = db.query(Tenant).filter(Tenant.id == tenant.id).first()
    if not t or not t.stripe_customer_id:
        return {"error": "no stripe customer"}
    session = create_portal_session(t.stripe_customer_id, return_url=settings.PUBLIC_BASE_URL)
    return {"url": session.url}

