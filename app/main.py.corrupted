@app.post("/v1/billing/webhook")
async def stripe_webhook(req: Request, stripe_signature: str = Header(None), db: Session = Depends(get_db)):
    event = construct_event(await req.body(), stripe_signature)
    et = event["type"]
    obj = event["data"]["object"]

    if et == "checkout.session.completed":
        customer = obj.get("customer")
        subscription = obj.get("subscription")
        email = (obj.get("customer_details") or {}).get("email")
        meta = obj.get("metadata") or {}
        tenant_name = meta.get("tenant_name", "Tenant")
        plan = meta.get("plan", "standard")

        tenant = db.query(Tenant).filter(Tenant.stripe_customer_id == customer).first()
        if not tenant:
            tenant = Tenant(
                name=tenant_name,
                stripe_customer_id=customer,
                stripe_subscription_id=subscription,
                plan=plan,
                is_active=True,
            )
            db.add(tenant); db.commit(); db.refresh(tenant)
            raw, kh = generate_api_key()
            db.add(ApiKey(tenant_id=tenant.id, key_hash=kh, name="default", is_active=True))
            db.commit()
            if email:
                existing = db.query(User).filter(User.email == email).first()
                if not existing:
                    user = User(tenant_id=tenant.id, email=email, password_hash=hash_password(generate_api_key()[0]), is_active=True, role="admin")
                    db.add(user); db.commit()
        else:
            tenant.stripe_subscription_id = subscription
            tenant.plan = plan
            tenant.is_active = True
            db.commit()

    if et in ("customer.subscription.updated", "customer.subscription.deleted"):
        customer = obj.get("customer")
        status = obj.get("status")
        tenant = db.query(Tenant).filter(Tenant.stripe_customer_id == customer).first()
        if tenant:
            tenant.is_active = (status in ("active", "trialing"))
            db.commit()

    return {"ok": True}

