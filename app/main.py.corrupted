@app.post("/api/templates/save")
def template_save(payload: dict, tenant=Depends(get_tenant), db: Session = Depends(get_db)):
    name = (payload.get("name") or "template").strip()
    upload_id = payload.get("upload_id") or ""
    mappings = payload.get("mappings") or []
    local_template_id = template_picker.save_template(name, upload_id, mappings, tenant_id=str(tenant.id))

    t = Template(tenant_id=tenant.id, name=name, payload={"upload_id": upload_id, "mappings": mappings, "local_template_id": local_template_id})
    db.add(t); db.commit(); db.refresh(t)
    return {"ok": True, "template_id": t.id, "local_template_id": local_template_id}

