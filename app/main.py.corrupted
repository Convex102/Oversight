@app.post("/v1/asgl-a/jobs")
def create_job(
    payload: dict,
    idempotency_key: Optional[str] = Header(default=None, alias="Idempotency-Key"),
    tenant=Depends(get_tenant),
    db: Session = Depends(get_db),
):
    assert_within_limits(db, tenant.id, tenant.plan)

    idem = (idempotency_key or payload.get("idempotency_key") or "").strip()
    if idem:
        existing_id = get_existing_job_id(tenant.id, idem)
        if existing_id:
            existing_job = db.query(Job).filter(Job.id == existing_id, Job.tenant_id == tenant.id).first()
            if existing_job:
                return {"job_id": existing_job.id, "status": existing_job.status, "idempotent_replay": True}

    upload_ids = payload.get("upload_ids", [])
    if not upload_ids:
        raise HTTPException(400, "upload_ids required")

    count = db.query(Upload).filter(Upload.id.in_(upload_ids), Upload.tenant_id == tenant.id).count()
    if count != len(upload_ids):
        raise HTTPException(400, "invalid upload_ids")

    job = Job(tenant_id=tenant.id, status="queued", request=payload)
    db.add(job)
    db.commit()
    db.refresh(job)

    run_job.delay(job.id)

    if idem:
        store_job_id(tenant.id, idem, job.id)

    return {"job_id": job.id, "status": job.status}

