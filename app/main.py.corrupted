@app.post("/console/jobs/run", response_class=HTMLResponse)
async def console_jobs_run(
    request: Request,
    files: List[UploadFile] = File(...),
    template_id: Optional[int] = Form(None),
    selection: Optional[str] = Form(None),
    user=Depends(get_current_user),
    db: Session = Depends(get_db),
):
    upload_ids: List[int] = []
    for f in files:
        data = await f.read()
        sha = hashlib.sha256(data).hexdigest()
        uri = storage.put(
            f"tenants/{user.tenant_id}/uploads/{sha}_{f.filename}",
            data,
            f.content_type or "application/octet-stream",
        )
        up = Upload(
            tenant_id=user.tenant_id,
            filename=f.filename,
            content_type=f.content_type or "",
            size_bytes=len(data),
            storage_uri=uri,
            sha256=sha,
        )
        db.add(up); db.commit(); db.refresh(up)
        upload_ids.append(up.id)

    payload: Dict[str, Any] = {"upload_ids": upload_ids, "options": {}}
    if template_id:
        payload["template_id"] = int(template_id)
    if selection:
        payload["selection"] = {"address": selection}

    job = Job(tenant_id=user.tenant_id, status="queued", request=payload)
    db.add(job); db.commit(); db.refresh(job)
    run_job.delay(job.id)

    jobs = db.query(Job).filter(Job.tenant_id == user.tenant_id).order_by(Job.id.desc()).limit(50).all()
    templates_rows = db.query(Template).filter(Template.tenant_id == user.tenant_id).order_by(Template.id.desc()).limit(50).all()
    return templates.TemplateResponse(
        "console_jobs.html",
        {**_ctx(request, "Jobs"), "user": user, "jobs": jobs, "templates": templates_rows, "job_created": job},
    )

