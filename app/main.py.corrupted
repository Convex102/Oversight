@app.get("/console", response_class=HTMLResponse)
def console_home(request: Request, user=Depends(get_current_user), db: Session = Depends(get_db)):
    tenant = db.query(Tenant).filter(Tenant.id == user.tenant_id).first()
    usage = get_or_create_usage(db, user.tenant_id)
    jobs = db.query(Job).filter(Job.tenant_id == user.tenant_id).order_by(Job.id.desc()).limit(25).all()
    keys = db.query(ApiKey).filter(ApiKey.tenant_id == user.tenant_id, ApiKey.is_active == True).all()
    return templates.TemplateResponse(
        "console.html",
        {**_ctx(request, "Console"), "user": user, "tenant": tenant, "usage": usage, "jobs": jobs, "keys": keys},
    )

