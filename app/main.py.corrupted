@app.get("/billing/portal")
def billing_portal_web(user=Depends(get_current_user), db: Session = Depends(get_db)):
    tenant = db.query(Tenant).filter(Tenant.id == user.tenant_id).first()
    if not tenant or not tenant.stripe_customer_id:
        raise HTTPException(400, "Billing portal not configured for this tenant")
    session = create_portal_session(tenant.stripe_customer_id, return_url=f"{settings.PUBLIC_BASE_URL}/console")
    return RedirectResponse(url=session.url, status_code=303)

