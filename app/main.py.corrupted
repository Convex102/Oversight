@app.post("/console/api-keys/create", response_class=HTMLResponse)
def console_keys_create(request: Request, name: str = Form("key"), user=Depends(get_current_user), db: Session = Depends(get_db)):
    raw, kh = generate_api_key()
    k = ApiKey(tenant_id=user.tenant_id, key_hash=kh, name=name, is_active=True)
    db.add(k); db.commit(); db.refresh(k)
    keys = db.query(ApiKey).filter(ApiKey.tenant_id == user.tenant_id).order_by(ApiKey.id.desc()).all()
    return templates.TemplateResponse("console_api_keys.html", {**_ctx(request, "API keys"), "user": user, "keys": keys, "new_key": raw})

