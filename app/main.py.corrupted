@app.post("/console/api-keys/revoke", response_class=HTMLResponse)
def console_keys_revoke(request: Request, key_id: int = Form(...), user=Depends(get_current_user), db: Session = Depends(get_db)):
    k = db.query(ApiKey).filter(ApiKey.id == key_id, ApiKey.tenant_id == user.tenant_id).first()
    if k:
        k.is_active = False
        db.commit()
    keys = db.query(ApiKey).filter(ApiKey.tenant_id == user.tenant_id).order_by(ApiKey.id.desc()).all()
    return templates.TemplateResponse("console_api_keys.html", {**_ctx(request, "API keys"), "user": user, "keys": keys})

