@app.post(
    "/v1/uploads",
    response_class=JSONResponse,
    response_model=None
)
async def upload_file(
    request: Request,
    file: UploadFile = File(...),
    tenant: Tenant = Depends(get_tenant),
    db: Session = Depends(get_db),
):
    try:
        if not file:
            raise HTTPException(400, "No file uploaded")

        data = await file.read()

        if not data:
            raise HTTPException(400, "Uploaded file is empty")

        # Optional: MIME validation (recommended)
        allowed_mimes = {
            "application/pdf",
            "text/csv",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        }
        if file.content_type not in allowed_mimes:
            raise HTTPException(400, f"Invalid MIME type: {file.content_type}")

        fname = (file.filename or "upload").strip()
        ext = os.path.splitext(fname)[1].lower()

        if ext and ext not in settings.allowed_upload_exts_set:
            raise HTTPException(
                status_code=400,
                detail=f"File type not allowed: {ext}"
            )

        if len(data) > settings.max_upload_bytes:
            raise HTTPException(
                status_code=413,
                detail=f"File too large (max {settings.MAX_UPLOAD_MB}MB)"
            )

        sha = hashlib.sha256(data).hexdigest()

        existing = (
            db.query(Upload)
            .filter(
                Upload.tenant_id == tenant.id,
                Upload.sha256 == sha
            )
            .order_by(Upload.id.desc())
            .first()
        )

        if existing:
            return JSONResponse(
                status_code=200,
                content={
                    "upload_id": existing.id,
                    "sha256": sha,
                    "filename": existing.filename,
                    "dedup": True,
                },
            )

        storage_path = f"tenants/{tenant.id}/uploads/{sha}_{fname}"
        uri = storage.put(
            storage_path,
            data,
            file.content_type or "application/octet-stream",
        )

        up = Upload(
            tenant_id=tenant.id,
            filename=fname,
            content_type=file.content_type or "",
            size_bytes=len(data),
            storage_uri=uri,
            sha256=sha,
        )

        db.add(up)
        db.commit()
        db.refresh(up)

        return JSONResponse(
            status_code=201,
            content={
                "upload_id": up.id,
                "sha256": sha,
                "filename": up.filename,
                "dedup": False,
            },
        )

    except HTTPException:
        raise
    except Exception as e:
        logger.exception("Upload failure")
        raise HTTPException(
            status_code=500,
            detail=f"Upload failed: {str(e)}"
        )

