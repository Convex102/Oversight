@app.post("/v1/asgl-a/jobs/{job_id}/review-queue/{item_id}/resolve")
async def api_resolve_review_queue_item(job_id: int, item_id: str, request: Request, tenant=Depends(get_tenant), db: Session = Depends(get_db)):
    job = db.query(Job).filter(Job.id == job_id, Job.tenant_id == tenant.id).first()
    if not job or not job.artifacts or "review_queue_json" not in job.artifacts:
        raise HTTPException(404, "Review queue not found")

    try:
        body = await request.json()
    except Exception:
        body = {}

    corrected_value = body.get("corrected_value")
    confirmed = body.get("confirmed", None)
    notes = body.get("notes")

    data = storage.get(job.artifacts["review_queue_json"])
    items = json.loads(data.decode("utf-8")) if data else []
    if not isinstance(items, list):
        raise HTTPException(500, "Review queue data corrupted")

    target = None
    for it in items:
        if str(it.get("item_id")) == str(item_id):
            target = it
            break
    if not target:
        raise HTTPException(404, "Review item not found")

    if confirmed is None:
        confirmed = (corrected_value is None) or (str(corrected_value) == str(target.get("proposed_value")))

    resolution = {
        "confirmed": bool(confirmed),
        "corrected_value": corrected_value,
        "notes": notes,
        "resolved_by": "api_key",
    }

    items = resolve_item(items, item_id=item_id, resolution=resolution)

    key = f"tenants/{tenant.id}/jobs/{job.id}/review_queue.json"
    review_uri = storage.put(key, json.dumps(items, ensure_ascii=False, indent=2).encode("utf-8"), "application/json")
    job.artifacts["review_queue_json"] = review_uri

    pri = load_priors(int(tenant.id))
    field = str(target.get("field") or "").strip()
    pri2 = apply_resolution(pri, field, confirmed=bool(confirmed), weight=float(max(0.25, min(3.0, 1.0 - float(target.get("confidence", 0.0) or 0.0)))))
    pri_uri = save_priors(int(tenant.id), pri2)

    try:
        record_signal(int(tenant.id), {
            "kind": "review_resolution",
            "job_id": int(job.id),
            "item_id": str(item_id),
            "field": field,
            "confirmed": bool(confirmed),
            "corrected_value": corrected_value,
            "confidence": float(target.get("confidence", 0.0) or 0.0),
            "notes": notes,
        })
    except Exception:
        pass

    db.add(job)
    db.commit()

    return {"ok": True, "review_queue_uri": review_uri, "priors_uri": pri_uri}

