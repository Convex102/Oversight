@app.get("/v1/di/signals")
def api_list_di_signals(limit: int = 50, tenant=Depends(get_tenant)):
    prefix = f"tenants/{tenant.id}/di/signals/"
    uris = storage.list_uris(prefix)
    uris = sorted(uris, reverse=True)[: int(limit)]
    signals = []
    for u in uris:
        try:
            raw = storage.get(u)
            signals.append(json.loads(raw.decode("utf-8")))
        except Exception:
            continue
    return {"count": len(signals), "signals": signals, "uris": uris}

